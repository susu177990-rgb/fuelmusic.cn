                    <tr key={name} className="border-t border-white/10">
                      
                      <td className="py-2 pr-4">{name}</td>
                      
                      <td className="py-2 px-4">{v.target}</td>
                      
                      <td className="py-2 px-4">{v.ok === null ? "--" : (v.ok ? "达标" : "不达标")}</td>
                      
                    </tr>
                    
                  ))}
                  
                </tbody>
                
              </table>
              
            </div>
            
            <div className="mt-3 text-xs text-white/50">* 目标范围尚未配置。你把各平台的响度目标发我后，这里会自动计算达标结果。</div>
            
          </div>
          
        </section>
        
        {/* 新页面骨架：到这里结束 */}
      </section>
    </div>
  );
}

