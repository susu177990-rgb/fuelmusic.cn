// ===== Key: 轻量 FFT + Chroma + 模板匹配 ===== 

// Hann 窗 
function hann(N:number){const w=new Float32Array(N);for(let n=0;n<N;n++){w[n]=0.5*(1-Math.cos(2*Math.PI*n/(N-1)));}return w;} 

// 简易 Radix-2 FFT（就地，输入实部/虚部） 
function fft_radix2(re:Float32Array, im:Float32Array){ 
  const N = re.length; let j=0; 
  for(let i=1;i<N-1;i++){ let bit=N>>1; for(; j&bit; bit>>=1) j^=bit; j|=bit; if(i<j){ const tr=re[i];re[i]=re[j];re[j]=tr; const ti=im[i];im[i]=im[j];im[j]=ti; } } 
  for(let len=2; len<=N; len<<=1){ 
    const ang = -2*Math.PI/len; const wlen_re=Math.cos(ang), wlen_im=Math.sin(ang); 
    for(let i=0;i<N;i+=len){ 
      let wr=1, wi=0; 
      for(let k=0;k<(len>>1);k++){ 
        const u_re=re[i+k], u_im=im[i+k]; 
        const v_re=re[i+k+(len>>1)]*wr - im[i+k+(len>>1)]*wi; 
        const v_im=re[i+k+(len>>1)]*wi + im[i+k+(len>>1)]*wr; 
        re[i+k] = u_re + v_re; im[i+k] = u_im + v_im; 
        re[i+k+(len>>1)] = u_re - v_re; im[i+k+(len>>1)] = u_im - v_im; 
        const nxt_re = wr*wlen_re - wi*wlen_im; 
        const nxt_im = wr*wlen_im + wi*wlen_re; 
        wr = nxt_re; wi = nxt_im; 
      } 
    } 
  } 
} 

// 计算一帧的幅度谱（对实信号），返回功率谱 
function frameSpectrum(frame:Float32Array){ 
  const N=frame.length; 
  const re=new Float32Array(N); re.set(frame); 
  const im=new Float32Array(N); 
  fft_radix2(re, im); 
  const mag=new Float32Array(N>>1); 
  for(let k=0;k<mag.length;k++){ const a=re[k], b=im[k]; mag[k]= (a*a+b*b); } 
  return mag; // power 
} 

// 频率 → 音高类（12）映射（A4=440Hz，等温律，A=9） 
function buildFreqToPitchClass(sampleRate:number, N:number){ 
  const bins=N>>1; const mapIdx=new Int16Array(bins); const mapW=new Float32Array(bins); 
  for(let k=0;k<bins;k++){ 
    const f = k*sampleRate/N; 
    if(f<20){ mapIdx[k]=-1; mapW[k]=0; continue; } // 忽略超低频 
    const p = 69 + 12*Math.log2(f/440); // MIDI 
    const pc = ((Math.round(p)%12)+12)%12; // 0..11 
    mapIdx[k]=pc; mapW[k]=1; // 简单等权；后续可做带通/谐波加权 
  } 
  return {mapIdx,mapW}; 
} 

// 从若干帧汇总 12 维 Chroma（单位归一化） 
function computeChroma(mono:Float32Array, sampleRate:number){ 
  // 取中段 15s 
  const midSec = 15, totalSec = mono.length / sampleRate; 
  const start = Math.floor(Math.max(0, (totalSec-midSec)/2) * sampleRate); 
  const end   = Math.min(mono.length, start + Math.floor(midSec*sampleRate)); 
  const x = mono.subarray(start, end); 

  // 可选下采样到 22050 
  const targetSR = 22050; 
  const step = Math.max(1, Math.floor(sampleRate/targetSR)); 
  const xs = (step>1) ? (()=>{ const L=Math.floor(x.length/step); const y=new Float32Array(L); for(let i=0,j=0;i<L;i++,j+=step)y[i]=x[j]; return y;})() : x; 
  const sr = (step>1)? Math.floor(sampleRate/step) : sampleRate; 

  // 分帧 
  const N=2048, H=512; const win=hann(N); 
  const {mapIdx,mapW}=buildFreqToPitchClass(sr, N); 

  // 帧级 chroma（帧内归一化），最后做"中位数聚合" 
  const frames: number[][] = []; 

  for(let i=0;i+N<=xs.length; i+=H){ 
    // 帧内归一化 + 加窗 
    let max=0; for(let t=0;t<N;t++){ const v=Math.abs(xs[i+t]); if(v>max) max=v; } 
    const fr=new Float32Array(N); 
    for(let t=0;t<N;t++){ fr[t]=(max>0? xs[i+t]/max : 0)*win[t]; } 

    const spec=frameSpectrum(fr); // power 
    const ch=new Float32Array(12); 

    for(let k=1;k<spec.length;k++){ 
      const idx=mapIdx[k]; if(idx<0) continue; 
      const f = k*sr/N; 
      if (f < 60) continue;                      // 忽略超低频 
      const wFreq = Math.pow(f/1000, -0.3);     // 中高频温和衰减 
      const val = Math.log10(1+spec[k]) * mapW[k] * wFreq; 
      ch[idx] += val; 
    } 
    // 帧内 L1 归一化，减少和声厚度偏置 
    let s=0; for(let m=0;m<12;m++) s += ch[m]; 
    if (s>0) for(let m=0;m<12;m++) ch[m] /= s; 

    frames.push(Array.from(ch)); 
  } 

  // 中位数聚合（比均值更抗异常） 
  const chroma = new Float32Array(12); 
  for(let m=0;m<12;m++){ 
    const col = frames.map(f => f[m]).sort((a,b)=>a-b); 
    const mid = col.length ? col[Math.floor(col.length/2)] : 0; 
    chroma[m] = mid; 
  } 
  // 全局 L1 归一化 
  let s=0; for(let i=0;i<12;i++) s+=chroma[i]; 
  if(s>0) for(let i=0;i<12;i++) chroma[i]/=s; 
  return chroma; 
} 

// 24 调式模板（Krumhansl-Schmuckler，简化归一化） 
const KRUM_MAJOR = [6.35,2.23,3.48,2.33,4.38,4.09,2.52,5.19,2.39,3.66,2.29,2.88]; 
const KRUM_MINOR = [6.33,2.68,3.52,5.38,2.60,3.53,2.54,4.75,3.98,2.69,3.34,3.17]; 
function rotate12(arr:number[], n:number){ const out=new Float32Array(12); for(let i=0;i<12;i++) out[(i+n)%12]=arr[i]; return out; } 
function dot(a:Float32Array,b:Float32Array){ let s=0; for(let i=0;i<12;i++) s+=a[i]*b[i]; return s; } 

// 根音索引到名称 
const NOTE_NAMES = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"]; 

type KeyGuess = { key:string; scale:"major"|"minor"; score:number }; 

function detectKeyFromChroma(chroma:Float32Array): { key:string; scale:"major"|"minor"; score:number } { 
  const NOTE_NAMES = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"]; 

  // 余弦相似度 
  function cosSim(x:Float32Array, y:Float32Array){ 
    let num=0, nx=0, ny=0; 
    for(let i=0;i<12;i++){ num+=x[i]*y[i]; nx+=x[i]*x[i]; ny+=y[i]*y[i]; } 
    return (nx>0 && ny>0)? num/Math.sqrt(nx*ny) : 0; 
  } 
  function rotate12(arr:number[], n:number){ const out=new Float32Array(12); for(let i=0;i<12;i++) out[(i+n)%12]=arr[i]; return out; } 

  const x = new Float32Array(chroma); 

  // 基础模板分 
  const majScores = new Float32Array(12); 
  const minScores = new Float32Array(12); 
  for(let r=0;r<12;r++){ 
    majScores[r] = cosSim(x, rotate12(KRUM_MAJOR, r)); 
    minScores[r] = cosSim(x, rotate12(KRUM_MINOR, r)); 
  } 

  // 三和弦增强（主和弦能量）：minor 用 (r, r+3, r+7)，major 用 (r, r+4, r+7) 
  function triadBoost(root:number, minor:boolean){ 
    const third = (root + (minor?3:4)) % 12; 
    const fifth = (root + 7) % 12; 
    const t = x[root] + 0.85*x[third] + 0.65*x[fifth]; // 主音>三度>五度 
    return t; 
  } 

  // 五度偏置惩罚：若五度显著强于主音则扣分（避免 C→F/G 偏移） 
  function fifthPenalty(root:number){ 
    const fifth = (root + 7) % 12; 
    const p = Math.max(0, x[fifth] - x[root]); // 只惩罚五度>主音的情况 
    return 0.35 * p; // 惩罚权重 
  } 

  // 组合得分：0.7*模板 + 0.35*三和弦增强 - 五度惩罚 
  function combinedScore(root:number, minor:boolean){ 
    const tpl = minor ? minScores[root] : majScores[root]; 
    const tri = triadBoost(root, minor); 
    const pen = fifthPenalty(root); 
    return 0.70*tpl + 0.35*tri - pen; 
  } 

  // 先取各自最大 
  let cand = {root:0, minor:false, score:-1}; 
  for(let r=0;r<12;r++){ 
    const sMaj = combinedScore(r,false); 
    const sMin = combinedScore(r,true); 
    if (sMaj > cand.score) cand = {root:r, minor:false, score:sMaj}; 
    if (sMin > cand.score) cand = {root:r, minor:true,  score:sMin}; 
  } 

  // —— 五度回拨：若五度显著压过主音，且"下五度候选"分数与当前相差 < 8%，回拨到下五度 —— 
  const root = cand.root; 
  const altRoot = (root + 12 - 7) % 12; // 下五度 
  const curTonic = x[root], curFifth = x[(root+7)%12]; 
  if (curFifth > curTonic * 1.22) { // 五度比主音强 ≥22% 
    const altScore = combinedScore(altRoot, cand.minor); 
    if (altScore >= cand.score * 0.92) { 
      cand = { root: altRoot, minor: cand.minor, score: altScore }; 
    } 
  } 

  return { key: NOTE_NAMES[cand.root], scale: cand.minor ? "minor" : "major", score: cand.score }; 
} 

